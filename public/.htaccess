# NOTE (Sept 2026 audit): this directive was previously wrapped in
# <IfModule mod_dir.c>. On this host that guard evaluates false, so the
# directive was silently skipped and EVERY prerendered route was still
# 301-redirecting to its trailing-slash form. Verified in production:
#   GET /application-mobile-el-jadida -> 301 -> /application-mobile-el-jadida/
# while that page's own rel=canonical points back at the no-slash URL, and
# all 149 sitemap entries + internal links use the no-slash form. GSC's
# stored googleCanonical is the no-slash URL, i.e. a redirecting URL.
# Left unguarded so it actually applies; the mod_rewrite fallback below
# covers hosts where DirectorySlash is unavailable.
DirectorySlash Off

<IfModule mod_dir.c>
  # scripts/prerender-static.mjs (Aug 2026 SEO audit) now writes each route's
  # prerendered HTML to dist/<route>/index.html (e.g.
  # dist/agence-digitale-meknes/index.html) instead of only dist/index.html.
  # Without this, mod_dir's default behavior 301-redirects a request for
  # /agence-digitale-meknes (no trailing slash, but now a real directory) to
  # /agence-digitale-meknes/ before serving it — a redirect that didn't exist
  # before and that conflicts with every canonical tag, sitemap entry and
  # internal link, which all use the no-trailing-slash form. This serves the
  # directory's index.html at the requested URL directly, no redirect.
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host is https://touatiayoub.com (see index.html's rel=canonical).
  # Collapse http:// and/or www. into ONE 301 straight to the canonical URL —
  # done as a single rule so a visitor never chains http -> https -> www (or
  # the reverse), which Lighthouse flags as "Avoid multiple page redirects"
  # and each extra hop adds a full DNS+TLS+request round trip before the
  # real document even starts loading.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Legacy /fr/, /en/, /ar/-prefixed routes from a pre-Aug-2026 site structure
  # (locale-prefixed paths; the current app has no such routes — locale is a
  # client-side toggle, not a URL segment). GSC's Aug 2026 Performance export
  # shows Google still has ~17 of these indexed with real signal — notably
  # /fr/developpeur-web-meknes at position ~7 with 23 impressions/3mo, better
  # than almost every current URL. Without this they'd 200-OK into the SPA
  # shell as soft-404s and that earned ranking signal would just be lost.
  # Specific high-value ones map to their real modern equivalent first;
  # anything else under a locale prefix falls through to the generic rule,
  # which strips the prefix and lets normal routing/not-found take over.
  RewriteRule ^fr/developpeur-web-meknes/?$ /agence-digitale-meknes [R=301,L]
  RewriteRule ^en/developpeur-web-meknes/?$ /agence-digitale-meknes [R=301,L]
  RewriteRule ^en/developpeur-nextjs-maroc/?$ /services/creation-site-web [R=301,L]
  RewriteRule ^(fr|en|ar)/about/?$ /a-propos [R=301,L]
  RewriteRule ^(fr|en)/portfolio/?$ /realisations [R=301,L]
  RewriteRule ^(fr|en)/services/?$ /services [R=301,L]
  RewriteRule ^fr/contact/?$ /contact [R=301,L]
  RewriteRule ^(fr|en|ar)/(process|privacy|terms)/?$ / [R=301,L]
  RewriteRule ^(fr|en|ar)/(.*)$ /$2 [R=301,L]

  # Montage Vidéo service discontinued (Aug 2026): removed from src/lib/seo-data.ts's
  # `services` array, so both its service-hub page and its 15 service×city
  # combination pages no longer render anywhere in the app. The hub URL still
  # gets real search traffic/links, so it 301s to the live /services index
  # instead of soft-404ing through the SPA fallback below. The per-city URLs
  # never accumulated meaningful signal and the service isn't coming back, so
  # they 410 Gone — telling crawlers to drop them, not merge/redirect them
  # into an unrelated surviving service page.
  RewriteRule ^services/montage-video/?$ /services [R=301,L]
  RewriteRule ^montage-video-.*$ - [G]

  # Host-independent belt-and-braces for the trailing-slash problem above.
  # If /foo has no trailing slash but dist/foo/index.html exists, serve that
  # file INTERNALLY (no redirect, no Location header) so the no-slash URL —
  # the one in the sitemap, the canonical tag and every internal link — is
  # the URL that actually returns 200. Must stay ahead of the SPA fallback.
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]

  # React Router SPA fallback for Hostinger static hosting.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# Vite fingerprints every build asset (dist/assets/*-<hash>.js/css) so a
# given URL's bytes never change — cache those forever. index.html is NOT
# fingerprinted (it's the thing that points at the current hashed assets),
# so it must always be revalidated or visitors keep getting a stale shell
# after a deploy. Missing long-lived cache headers on static assets is a
# straight "Serve static assets with an efficient cache policy" ding in
# Lighthouse, on every load, not just repeat visits.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType text/javascript         "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|png|jpe?g|webp|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Belt-and-suspenders text compression in case Hostinger's server-level gzip
# isn't already covering these MIME types.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
